{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Demon Codex public entity proposal",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "entityId": {
      "type": "string",
      "pattern": "^entity:[a-z0-9][a-z0-9-]*$"
    },
    "kind": {
      "enum": [
        "canonical",
        "anomalous"
      ]
    },
    "codexId": {
      "type": "string",
      "pattern": "^(00[1-9]|0[1-9][0-9]|[1-5][0-9]{2}|6[0-5][0-9]|66[0-6])$"
    },
    "approval": {
      "enum": [
        "PROPOSAL",
        "WORKING DECISION",
        "CANON"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "faction": {
          "type": "string",
          "minLength": 1
        },
        "element": {
          "type": "string",
          "minLength": 1
        },
        "archetype": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name"
      ]
    },
    "lore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "history": {
          "type": "string",
          "minLength": 1
        },
        "personality": {
          "type": "string",
          "minLength": 1
        },
        "symbols": {
          "type": "string",
          "minLength": 1
        },
        "sigil": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "silhouette": {
          "type": "string",
          "minLength": 1
        },
        "palette": {
          "type": "string",
          "minLength": 1
        },
        "materials": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "portraitRef": {
          "type": "string",
          "minLength": 1
        },
        "gameplayRef": {
          "type": "string",
          "minLength": 1
        },
        "animationRef": {
          "type": "string",
          "minLength": 1
        },
        "voiceProfileRef": {
          "type": "string",
          "minLength": 1
        },
        "musicalMotifRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gameplay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "abilityRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "effectRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rarities": {
          "type": "array",
          "items": {
            "enum": [
              "Common",
              "Uncommon",
              "Rare",
              "Epic",
              "Legendary",
              "Infernal"
            ]
          },
          "uniqueItems": true
        },
        "specialClassifications": {
          "type": "array",
          "items": {
            "enum": [
              "Hidden",
              "Anomaly",
              "Mythic",
              "Unique",
              "Unnumbered"
            ]
          },
          "uniqueItems": true
        },
        "editions": {
          "type": "array",
          "items": {
            "enum": [
              "Standard",
              "Seasonal",
              "Limited",
              "Genesis",
              "Founder",
              "Artist",
              "Creator"
            ]
          },
          "uniqueItems": true
        },
        "skinRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "relicRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "commerce": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tradePolicyRef": {
          "type": "string",
          "minLength": 1
        },
        "forgePolicyRef": {
          "type": "string",
          "minLength": 1
        },
        "mintEligibilityPolicyRef": {
          "type": "string",
          "minLength": 1
        },
        "redemptionEligibilityPolicyRef": {
          "type": "string",
          "minLength": 1
        },
        "physicalProductRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "entityId",
    "kind",
    "approval",
    "identity"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "canonical"
          }
        }
      },
      "then": {
        "required": [
          "codexId"
        ]
      },
      "else": {
        "not": {
          "required": [
            "codexId"
          ]
        }
      }
    }
  ]
}
